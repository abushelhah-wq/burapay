# ---------------------------------------------------------------------------
# Payment gateway API benchmark - credential template
#
# Copy to .env and fill in what you have:  cp .env.example .env
# .env is gitignored. Never commit real keys.
#
# Every gateway is optional. Anything left blank is reported as "not configured"
# and skipped - it never fails the run. Stripe and Moyasar are self-serve and are
# the fastest path to real numbers; see docs/01_sandbox_signup_guide.md.
# ---------------------------------------------------------------------------

# --- Benchmark settings ----------------------------------------------------
RUNS_PER_CALL=30            # measured repetitions per flow
WARMUP_RUNS=2               # discarded before measuring (covers TCP/TLS setup)
DELAY_BETWEEN_RUNS_MS=0     # pause between runs; raise for rate-limited gateways
                            # (HyperPay's Copy&Pay status GET is capped at 2/min)
HTTP_TIMEOUT_SECONDS=30
TEST_AMOUNT=10.00
TEST_CURRENCY=USD

# Where you ran this from. Latency is meaningless without it - run from the same
# MENA-region infrastructure your merchants use, not from a laptop on another continent.
MEASUREMENT_LOCATION=

# --- Geidea (baseline) -----------------------------------------------------
# Issued by Geidea's enablement team, or found in the merchant portal under
# Payment Gateway -> Gateway Settings. Ask specifically for SANDBOX/TEST keys.
GEIDEA_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
GEIDEA_REGION=eg                        # eg | ksa | uae  (selects the regional host)
# GEIDEA_API_BASE=                      # overrides GEIDEA_REGION entirely
# GEIDEA_TIMESTAMP_FORMAT=%Y-%m-%dT%H:%M:%S   # strftime; change if the sandbox rejects the signature
# GEIDEA_FORCE_FULL_3DS=0               # 1 = always run all 4 Direct API calls
GEIDEA_CALLBACK_URL=https://example.com/geidea/callback
GEIDEA_RETURN_URL=https://example.com/geidea/return
# MIT needs a tokenId minted from an earlier session that carried cardOnFile:true.
# Without it the MIT flow is skipped rather than guessed at.
GEIDEA_TOKEN_ID=
GEIDEA_AGREEMENT_ID=
# GEIDEA_TEST_CARD_NUMBER=5123450000000008
# GEIDEA_TEST_CARD_MONTH=1
# GEIDEA_TEST_CARD_YEAR=39
# GEIDEA_TEST_CARD_CVV=100

# --- Adyen -----------------------------------------------------------------
# Test Customer Area -> Developers -> API credentials.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_API_BASE=https://checkout-test.adyen.com
ADYEN_API_VERSION=v71
ADYEN_COUNTRY_CODE=NL
ADYEN_RETURN_URL=https://example.com/adyen/return
# The card-on-file token arrives on the recurring.token.created webhook, not in the
# store-card response, so it has to be captured out of band. Blank = MIT is skipped.
ADYEN_STORED_PAYMENT_METHOD_ID=
ADYEN_SHOPPER_REFERENCE=gateway-benchmark-shopper

# --- Stripe ----------------------------------------------------------------
# Dashboard -> Developers -> API keys. A restricted key (rk_...) scoped to Payments,
# Checkout Sessions and Refunds is enough and is Stripe's current recommendation.
STRIPE_SECRET_KEY=
# STRIPE_API_VERSION=                   # pin an API version if you need reproducibility
STRIPE_TEST_TOKEN=tok_visa              # Stripe's frictionless test-card token
STRIPE_SUCCESS_URL=https://example.com/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://example.com/cancel

# --- Checkout.com ----------------------------------------------------------
# Sandbox dashboard. NAS accounts may show a subdomain prefix on the API host -
# copy it from the dashboard into CHECKOUT_API_BASE if so.
CHECKOUT_SECRET_KEY=
CHECKOUT_PUBLIC_KEY=                    # needed to mint card tokens; blank = Direct API/MIT skipped
CHECKOUT_API_BASE=https://api.sandbox.checkout.com
# CHECKOUT_PROCESSING_CHANNEL_ID=       # required on NAS accounts
CHECKOUT_COUNTRY=GB
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_FAILURE_URL=https://example.com/failure

# --- HyperPay --------------------------------------------------------------
# Not self-serve: request Test System access via HyperPay sales/merchant support.
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_API_BASE=https://eu-test.oppwa.com
# Back-office (capture/refund/void) URL shape is UNVERIFIED against a HyperPay page.
# flat   -> POST /v1/payments/{id}            (default)
# nested -> POST /v1/payments/{id}/payments   (Peach Payments' shape, same OPPWA engine)
HYPERPAY_BACKOFFICE_PATH=flat
HYPERPAY_REGISTRATION_ID=               # blank = one is minted inline for the MIT flow

# --- Moyasar ---------------------------------------------------------------
# Dashboard. Basic auth: secret key as username, empty password.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=                # needed for the tokenize-first Direct API path
MOYASAR_CURRENCY=SAR                    # Moyasar sandboxes are SAR-first
# Moyasar's own docs disagree on the Direct API minimum:
#   token -> POST /v1/tokens, POST /v1/payments, GET /v1/payments/{id}   (3 calls, recommended guide)
#   card  -> POST /v1/payments, GET /v1/payments/{id}                    (2 calls, API reference)
MOYASAR_DIRECT_MODE=token
MOYASAR_CALLBACK_URL=https://example.com/moyasar/callback
