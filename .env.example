# ---------------------------------------------------------------------------
# busrapay — gateway benchmark web app
#
#   cp .env.example .env      then fill in what you have
#
# .env is gitignored. Use sandbox keys only; never commit real credentials.
# Every gateway is optional — one with no credentials shows as "not configured"
# in the UI and cannot be selected, rather than failing when you press Pay.
# ---------------------------------------------------------------------------

# --- HTTPS -----------------------------------------------------------------
# The public https:// origin this app is reachable at. Gateways redirect the
# customer back to it and POST webhooks to it, and sandboxes reject non-HTTPS
# values for both — so hosted checkout is refused until this is an https URL.
# Server-side flows (Direct, capture, refund, void, MIT) work without it.
PUBLIC_BASE_URL=https://busrapay.com

# Local development with a self-signed certificate (./scripts/make_cert.sh):
#   SSL_CERTFILE=certs/cert.pem
#   SSL_KEYFILE=certs/key.pem
#   PUBLIC_BASE_URL=https://localhost:8443
# Leave both unset when something upstream terminates TLS (Caddy, nginx, an ALB).
SSL_CERTFILE=
SSL_KEYFILE=

HOST=0.0.0.0
PORT=8443
FORCE_HTTPS=1
# Trust X-Forwarded-Proto. Required behind a reverse proxy; must stay 0 when the
# app is exposed directly, since the header is client-settable.
BEHIND_PROXY=0

# Used only by deploy/docker-compose.yml, for the automatic Let's Encrypt cert.
DOMAIN=busrapay.com
ACME_EMAIL=you@example.com

# --- Benchmark defaults ----------------------------------------------------
TEST_AMOUNT=10.00
TEST_CURRENCY=SAR
HTTP_TIMEOUT_SECONDS=30
DATABASE_PATH=data/results.db

# Where this instance runs. Latency is meaningless without it — record the region
# your merchants actually transact from.
MEASUREMENT_LOCATION=

# Sandbox test card for the server-side flows.
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_MONTH=12
TEST_CARD_YEAR=2030
TEST_CARD_CVC=123
TEST_CARD_HOLDER=Benchmark Runner

# Lets the Direct flow accept a card typed into the browser form. Off by default:
# that path puts this app in PCI scope. Only ever turn it on against sandbox
# credentials with test cards.
ALLOW_DIRECT_CARD_ENTRY=0

# --- Geidea (baseline) -----------------------------------------------------
# Issued by Geidea's enablement team, or in the merchant portal under
# Payment Gateway -> Gateway Settings. Ask specifically for SANDBOX keys.
GEIDEA_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
# Regional host: ksa | eg | uae. A SAR sandbox is almost always KSA-issued.
GEIDEA_REGION=ksa
# GEIDEA_API_BASE=                            # overrides GEIDEA_REGION entirely
# Signature/timestamp details that could not be confirmed from public docs. If a
# call is rejected for a bad signature, change this before touching the adapter.
# GEIDEA_TIMESTAMP_FORMAT=%Y-%m-%dT%H:%M:%S
# GEIDEA_FORCE_FULL_3DS=0                     # 1 = always run all 4 Direct calls
# MIT needs a tokenId from a session that carried cardOnFile:true. Without it the
# MIT flow reports what is missing instead of guessing.
GEIDEA_TOKEN_ID=
GEIDEA_AGREEMENT_ID=

# --- Stripe ----------------------------------------------------------------
# Dashboard -> Developers -> API keys. A restricted key scoped to Payments,
# Checkout Sessions and Refunds is enough.
STRIPE_SECRET_KEY=
STRIPE_TEST_TOKEN=tok_visa
# STRIPE_API_VERSION=

# --- Adyen -----------------------------------------------------------------
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_API_BASE=https://checkout-test.adyen.com
ADYEN_API_VERSION=v71
ADYEN_COUNTRY_CODE=NL
# The card-on-file token arrives on the recurring.token.created webhook, not in
# the store-card response, so it must be captured out of band.
ADYEN_STORED_PAYMENT_METHOD_ID=

# --- Checkout.com ----------------------------------------------------------
CHECKOUT_SECRET_KEY=
CHECKOUT_PUBLIC_KEY=                          # needed to mint card tokens
CHECKOUT_API_BASE=https://api.sandbox.checkout.com
# CHECKOUT_PROCESSING_CHANNEL_ID=             # required on NAS accounts
CHECKOUT_COUNTRY=GB

# --- HyperPay --------------------------------------------------------------
# Not self-serve: request Test System access through HyperPay sales/support.
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_API_BASE=https://eu-test.oppwa.com
# Back-office URL shape for capture/refund/void is UNVERIFIED against a HyperPay
# page. flat -> /v1/payments/{id} ; nested -> /v1/payments/{id}/payments (Peach).
HYPERPAY_BACKOFFICE_PATH=flat
HYPERPAY_REGISTRATION_ID=

# --- Moyasar ---------------------------------------------------------------
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=                      # needed for the tokenize-first path
# Moyasar's docs disagree with themselves on the Direct minimum:
#   token -> tokens, payments, fetch   (3 calls, their recommended guide)
#   card  -> payments, fetch           (2 calls, their API reference)
MOYASAR_DIRECT_MODE=token
