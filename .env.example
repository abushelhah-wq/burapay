# BuraPay Gateway Benchmark — environment template.
#
#   cp .env.example .env
#
# NEVER commit .env. It is in .gitignore, and it holds the keys that protect every
# stored gateway credential.
#
# Gateway credentials are NOT set here. They are entered on the Settings page and
# stored encrypted in the database, so rotating a sandbox key needs no redeploy.

# --------------------------------------------------------------------------- #
# Secrets — generate real values before deploying
# --------------------------------------------------------------------------- #

# Signs session tokens.
#   openssl rand -hex 32
APP_SECRET_KEY=change-me-generate-a-random-32-byte-value

# Encrypts stored gateway credentials (Fernet). Losing this means losing every
# stored credential — there is no recovery path, by design. Back it up somewhere
# that is not this server.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# The first administrator, created only when the platform has no users at all.
# Change the password immediately after the first sign-in; editing this later does
# nothing, because by then the account exists.
BOOTSTRAP_ADMIN_EMAIL=admin@busrapay.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-boot

# --------------------------------------------------------------------------- #
# Database
# --------------------------------------------------------------------------- #

POSTGRES_USER=burapay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=burapay

# Used by the backend directly. docker compose builds this from the values above;
# set it explicitly when running the backend outside Docker.
# DATABASE_URL=postgresql+asyncpg://burapay:change-me@localhost:5432/burapay

# --------------------------------------------------------------------------- #
# Deployment — Traefik
# --------------------------------------------------------------------------- #
#
# BuraPay integrates with the Traefik that is already running on the VPS. It does not
# start a Traefik of its own, and it must not disturb the routers, networks, TLS or
# certificates belonging to anything else on the host.
#
# Do not guess these three values. Run this on the VPS and read them off:
#
#     ./scripts/inspect-traefik.sh
#
# It prints the network Traefik is on, the entrypoint and certificate resolver the
# host's other applications already use, whether a global HTTP→HTTPS redirect exists,
# and whether anything already claims this domain. It changes nothing.

DOMAIN=busrapay.com

# ONLY needed when the existing Traefik runs in its own Docker network. If it uses
# host networking — which is the common single-VPS arrangement, and what
# inspect-traefik.sh reports — leave this unset and start with a plain
# `docker compose up -d`. When it is set, start with the override that joins that
# network:
#
#     docker compose -f docker-compose.yml -f docker-compose.traefik-network.yml up -d
#
# TRAEFIK_NETWORK=traefik

# The HTTPS entrypoint name in the existing Traefik's static configuration. Often
# websecure or https.
TRAEFIK_ENTRYPOINT=websecure

# The existing certificate resolver. Often letsencrypt, le, cloudflare or production.
# A wrong name here fails quietly — Traefik logs the error and serves its default
# self-signed certificate — so confirm it against a working router on the host.
TRAEFIK_CERT_RESOLVER=letsencrypt

# The public origin gateways redirect the browser back to and POST webhooks to.
# Must be https:// — every gateway sandbox rejects plaintext return and callback URLs.
PUBLIC_BASE_URL=https://busrapay.com

# Origins allowed to call the API from a browser. In production this is the site
# itself; add http://localhost:5173 when running the Vite dev server.
CORS_ORIGINS=https://busrapay.com

APP_ENV=production
LOG_LEVEL=INFO

# Optional, recorded with every benchmark run so results from different hosts can be
# told apart before they are compared.
SERVER_REGION=

# --------------------------------------------------------------------------- #
# Benchmark safety
# --------------------------------------------------------------------------- #

# Sandbox only. Setting this to true allows benchmark transactions against
# production gateway environments — a deliberate change, never a default.
ALLOW_PRODUCTION_GATEWAYS=false

# The floor for automated runs: one transaction every N seconds. Raise it for any
# gateway whose documented rate limit is stricter.
BENCHMARK_MIN_INTERVAL_SECONDS=2
BENCHMARK_MAX_TRANSACTIONS_PER_RUN=500

# Timeout applied to every outbound gateway call, in seconds.
HTTP_TIMEOUT_SECONDS=30

# Allows a card number typed into the browser to reach a Direct API flow. Off by
# default: that path puts this application in PCI scope and is only ever appropriate
# against sandbox credentials with test cards. With it off the API rejects a request
# carrying card details rather than ignoring them, and the Run Benchmark page says so.
#
# A Card token ID needs no permission and works either way — a token is not card data,
# and it is the only way to run a Direct payment on a gateway account that is not
# cleared to receive raw card numbers.
ALLOW_DIRECT_CARD_ENTRY=false
