# ---------------------------------------------------------------------------
# BuraPay — payment gateway performance benchmarking
#
#   cp .env.example .env      then fill in what you have
#
# .env is gitignored. Use SANDBOX credentials only.
#
# WHAT CHANGED IN THIS RELEASE
# ----------------------------
# Nothing was renamed and nothing was removed. Variables that the previous
# release used and this one no longer reads are marked OBSOLETE below rather
# than deleted, so an existing .env keeps working and you can see exactly what
# stopped mattering.
#
# New variables were added, because gateway credentials now live encrypted in
# the database rather than only in the environment. The GEIDEA_* variables
# below still work: on first start they are imported into the encrypted store,
# after which the Settings page is authoritative and the environment is no
# longer consulted for them.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. REQUIRED — the application will not function correctly without these
# ===========================================================================

# Signs session cookies. Rotating it signs everyone out; it never touches
# stored gateway credentials.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Fernet key encrypting gateway credentials at rest. There is exactly one such
# key and one consumer (CredentialStore). Never derive a second key from it and
# never add a second variable for the same purpose.
#
# BACK THIS UP. If you lose it, every stored credential becomes unreadable and
# must be re-entered.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# The public https:// origin this deployment answers on. Every gateway return
# URL and callback URL is built from it, and it is the ONLY place a domain
# appears anywhere in the system — so a staging deploy on another host works
# with no code change.
#
# Gateway sandboxes reject non-HTTPS return and callback URLs, so hosted
# checkout is refused until this is an https:// value. Server-side flows
# (Direct API, capture, refund, void) work regardless.
PUBLIC_BASE_URL=https://busrapay.com

# Used by docker-compose.yml for the Let's Encrypt certificate, and as the
# Traefik router Host() rule when the Traefik override is in use.
DOMAIN=busrapay.com
ACME_EMAIL=you@example.com

# --- Database (Postgres) ---------------------------------------------------
# docker-compose.yml builds DATABASE_URL from these three. Set DATABASE_URL
# explicitly only for a non-Docker local run.
POSTGRES_USER=burapay
POSTGRES_PASSWORD=
POSTGRES_DB=burapay
# DATABASE_URL=postgresql+asyncpg://burapay:password@127.0.0.1:5432/burapay

# Job queue. Compose sets this; override only for a non-Docker local run.
# REDIS_URL=redis://redis:6379/0


# ===========================================================================
# 2. FIRST ADMINISTRATOR
# ===========================================================================
# Used ONLY to create the first admin, and only while the users table is empty.
# They are read on every start but acted on in that one case, so changing the
# password here after the account exists does nothing — change it in the app.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=


# ===========================================================================
# 3. SAFETY FLAGS — all enforced server-side, not in the UI
# ===========================================================================
# Both 1/0 and true/false parse, so neither spelling is silently misread.

# When false, the backend refuses to run any transaction against a gateway
# credential flagged "production" in gateway_credentials. Enforced at the
# adapter layer, so calling the API directly does not bypass it.
ALLOW_PRODUCTION_GATEWAYS=false

# Allows the Direct API endpoints to accept a card typed into the browser form.
# When off, those endpoints return 403 — the button being hidden is not the
# enforcement. This path puts the application in PCI scope; only ever enable it
# against sandbox credentials with test cards.
ALLOW_DIRECT_CARD_ENTRY=1

# Enforced by the benchmark executor, not advisory. A run that would exceed the
# maximum STOPS and records why — it is never silently truncated, because a
# partial run reported as a whole one misrepresents the results.
BENCHMARK_MIN_INTERVAL_SECONDS=60
BENCHMARK_MAX_TRANSACTIONS_PER_RUN=50

# The single default timeout for the shared gateway HTTP client. It is recorded
# on every logged call, so "gateway X times out more than gateway Y" is a
# measured output rather than a guess. A per-gateway override is allowed only
# where that gateway's documentation states a different required value, and
# must be commented as a deviation in the adapter.
HTTP_TIMEOUT_SECONDS=30


# ===========================================================================
# 4. REVERSE PROXY
# ===========================================================================
# Two supported arrangements.
#
# (a) LEAVE TRAEFIK_NETWORK UNSET — the default. docker-compose.yml runs its own
#     Caddy, which obtains and renews a Let's Encrypt certificate automatically:
#         docker compose up -d
#
# (b) SET ALL THREE — for a host that already runs Traefik:
#         docker compose -f docker-compose.yml \
#                        -f docker-compose.traefik-network.yml up -d
#
# These values MUST come from running scripts/inspect-traefik.sh on the actual
# VPS. Do not guess them: an entrypoint or resolver name that does not exist
# produces a router Traefik silently ignores, which is indistinguishable from
# the application being down.
# LEAVE TRAEFIK_NETWORK EMPTY for host-network Traefik (the usual single-VPS
# arrangement). The router labels are in docker-compose.yml either way; this
# variable only says which Docker network Traefik should route over.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# The Docker network this stack puts its web-facing containers on. Named
# explicitly so the traefik.docker.network label is right regardless of which
# directory you deploy from. Change it only if a second copy of this stack runs
# on the same host.
BURAPAY_WEB_NETWORK=burapaynew_web

# Prefix for the Traefik router names. Change it if another stack on this host
# already defines routers with the same names -- two routers claiming the same
# Host() rule makes Traefik pick one unpredictably.
TRAEFIK_ROUTER_PREFIX=burapaynew

# Comma-separated allow-list for the API's CORS middleware. Leave empty in a
# normal deployment: the proxy serves the API and the frontend from one origin,
# so the browser never makes a cross-origin request. Only needed when running
# the frontend dev server against a remote API.
CORS_ORIGINS=


# ===========================================================================
# 5. BENCHMARK CONTEXT
# ===========================================================================
# Where this instance runs. Latency is meaningless without it — record the
# region your merchants actually transact from.
MEASUREMENT_LOCATION=

TEST_AMOUNT=10.00
TEST_CURRENCY=SAR

# Convenience defaults for the card entry form. Real sandbox test cards should
# come from the gateway's own test-cards documentation, which the UI links to.
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_MONTH=12
TEST_CARD_YEAR=2030
TEST_CARD_CVC=123
TEST_CARD_HOLDER=Benchmark Runner

LOG_LEVEL=INFO


# ===========================================================================
# 6. GATEWAY CREDENTIALS (seed only)
# ===========================================================================
# Credentials now live encrypted in the gateway_credentials table. Anything set
# here is imported into that table on first start and then ignored — the
# Settings page is authoritative once a value has been saved there.
#
# You can leave this whole section empty and enter credentials in the UI. It
# exists so an existing .env from the previous release keeps working.

# --- Geidea (baseline) -----------------------------------------------------
# Issued by Geidea's enablement team, or in the merchant portal under
# Payment Gateway -> Gateway Settings. Ask specifically for SANDBOX keys.
GEIDEA_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
# Regional host: ksa | eg | uae. A SAR sandbox is almost always KSA-issued.
GEIDEA_REGION=ksa
# GEIDEA_API_BASE=                            # overrides GEIDEA_REGION entirely

# Kept from the previous release and now UNUSED, because both values are held
# per-token in the database rather than globally in the environment.
#
# MIT needs a tokenId minted from a save-card or cardOnFile flow, plus an
# agreement id. Geidea does not issue the agreement id -- this platform
# generates one at tokenization and replays the same value on every later
# merchant-initiated charge, so it is stored on the token row. A single
# environment variable could only ever hold one token, which is the wrong shape
# for a benchmark that saves several.
GEIDEA_TOKEN_ID=
GEIDEA_AGREEMENT_ID=

# The two signing details the previous release could not confirm are now
# per-gateway configuration rather than environment variables, editable from the
# Settings page without a redeploy. They live in gateways.config_json as:
#   timestamp_format   (was GEIDEA_TIMESTAMP_FORMAT)
#   force_full_3ds     (was GEIDEA_FORCE_FULL_3DS)
#   signature_fields   (new — the concatenation order, which is inferred)

# --- Other gateways --------------------------------------------------------
# These adapters have NOT yet been ported to the async GatewayAdapter interface.
# The variables are kept so nothing is lost from an existing .env; the previous
# synchronous implementations are in git history at commit cc361a4. See the
# README section "Adding a gateway adapter".
STRIPE_SECRET_KEY=
STRIPE_TEST_TOKEN=tok_visa
# STRIPE_API_VERSION=

ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_API_BASE=https://checkout-test.adyen.com
ADYEN_API_VERSION=v71
ADYEN_COUNTRY_CODE=NL
# The card-on-file token arrives on the recurring.token.created webhook, not in
# the store-card response, so it has to be captured out of band.
ADYEN_STORED_PAYMENT_METHOD_ID=

CHECKOUT_SECRET_KEY=
CHECKOUT_PUBLIC_KEY=
CHECKOUT_API_BASE=https://api.sandbox.checkout.com
# CHECKOUT_PROCESSING_CHANNEL_ID=             # required on NAS accounts
CHECKOUT_COUNTRY=GB

HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_API_BASE=https://eu-test.oppwa.com
# Back-office URL shape for capture/refund/void is UNVERIFIED against a HyperPay
# page. flat -> /v1/payments/{id} ; nested -> /v1/payments/{id}/payments (Peach).
HYPERPAY_BACKOFFICE_PATH=flat
HYPERPAY_REGISTRATION_ID=

MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_DIRECT_MODE=token


# ===========================================================================
# 7. OBSOLETE — read by the previous release, ignored by this one
# ===========================================================================
# Kept so an existing .env still loads. Safe to delete once you are confident
# you will not roll back.
#
# DATABASE_PATH   — was the SQLite file. All state is now in Postgres.
# SSL_CERTFILE    — the app no longer terminates TLS; Caddy or Traefik does.
# SSL_KEYFILE     — ditto.
# HOST            — the container always binds 0.0.0.0:8000.
# PORT            — ditto.
# FORCE_HTTPS     — the proxy handles the http->https redirect.
# BEHIND_PROXY    — uvicorn runs with --proxy-headers unconditionally, because
#                   the container is never exposed directly.
